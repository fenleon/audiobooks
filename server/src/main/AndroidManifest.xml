<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- BT connection state for the Library's connected-BT icon (getDevices
         filters BT devices without it on API 31+). Runtime permission — grant
         with adb (like passes' CAMERA). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- sdk:ui merges CAMERA for its QR scanner; the companion is a media server. -->
    <uses-permission
        android:name="android.permission.CAMERA"
        tools:node="remove" />

    <application
        android:name=".ServerApplication"
        android:allowBackup="false"
        android:icon="@android:mipmap/sym_def_app_icon"
        android:label="Audiobooks Server"
        android:theme="@android:style/Theme.Black.NoTitleBar"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Hosts the system media-delete consent dialog; started by the tool
             (the companion can't launch activities from the background). -->
        <activity
            android:name=".DeleteConsentActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Transparent bridge to the system Bluetooth settings; started by
             the tool's Library bar (Bluetooth link). -->
        <activity
            android:name=".BluetoothSettingsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Serves the library files to the tool's detached player (the tool
             has no storage access). Exported so the tool's process can read
             the URIs — see AudiobookMediaProvider. -->
        <provider
            android:name=".AudiobookMediaProvider"
            android:authorities="com.lightphone.audiobooks.server.media"
            android:exported="true" />

        <!-- sdk:client merges its UnifiedPush service + file-share provider;
             the companion is a local media server and uses neither. -->
        <service
            android:name="com.thelightphone.sdk.LightPushService"
            tools:node="remove" />
        <provider
            android:name="com.thelightphone.sdk.LightFileProvider"
            tools:node="remove" />
    </application>

</manifest>
