<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- BT connection state for the Library's connected-BT icon (getDevices
         filters BT devices without it on API 31+). Runtime permission — grant
         with adb (like passes' CAMERA). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Merged into the tool APK (single-module build, 2026-08-18). The
         tool's generated manifest provides the application class, label, and
         launcher; this library contributes only components. -->
    <application>

        <!-- Hosts the system media-delete consent dialog; started by the tool
             (a background service can't launch activities). -->
        <activity
            android:name=".DeleteConsentActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Transparent bridge to the system Bluetooth settings; started by
             the tool's Library bar (Bluetooth link). -->
        <activity
            android:name=".BluetoothSettingsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Requests READ_MEDIA_AUDIO (the scan + media provider need it) and
             finishes. The old companion asked on its launcher activity; the
             merged build has no companion activity, so the tool launches this
             via the SDK's permission flow (LightSdkServer.permissionActivity). -->
        <activity
            android:name=".MediaPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Serves the library files to the detached player as `content://`
             URIs (the tool runtime forbids storage access; the provider holds
             the audio read permission). -->
        <provider
            android:name=".AudiobookMediaProvider"
            android:authorities="com.lightphone.audiobooks.server.media"
            android:exported="true" />

        <!-- Wires the SDK server settings + scan at app start, before the
             tool's first binder call (Application.onCreate runs before
             providers, so the bind in LightSdkApplication is unaffected). -->
        <provider
            android:name=".ServerBootstrapProvider"
            android:authorities="com.lightphone.audiobooks.server.bootstrap"
            android:exported="false" />
    </application>

</manifest>
